{
  "name": "aaswitch-hub",
  "version": "0.1.0",
  "private": true,
  "description": "aaswitch 账号与设备中枢服务（ToDesk 模式）：账号、设备登记与 relay offer 发现",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
