#!/usr/bin/env bash
set -euo pipefail

IMAGE_HOME="/home/aaswitch"

: "${HOME:=$IMAGE_HOME}"
: "${AASWITCH_HOME:=${HOME}/.aaswitch}"
: "${AASWITCH_LISTEN:=0.0.0.0:6767}"
: "${AASWITCH_WEB_UI_ENABLED:=true}"
: "${AASWITCH_LOG_LEVEL:=info}"
: "${AASWITCH_LOG_FORMAT:=json}"
: "${CLAUDE_CONFIG_DIR:=${HOME}/.claude}"
: "${CODEX_HOME:=${HOME}/.codex}"
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
: "${XDG_STATE_HOME:=${HOME}/.local/state}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"

export HOME
export AASWITCH_HOME
export AASWITCH_LISTEN
export AASWITCH_WEB_UI_ENABLED
export AASWITCH_LOG_LEVEL
export AASWITCH_LOG_FORMAT
export CLAUDE_CONFIG_DIR
export CODEX_HOME
export XDG_CONFIG_HOME
export XDG_DATA_HOME
export XDG_STATE_HOME
export XDG_CACHE_HOME

ensure_dir() {
  local dir="$1"
  mkdir -p "$dir"
  if [[ "$(id -u)" == "0" ]]; then
    local owner
    owner="$(stat -c "%u" "$dir")"
    if [[ "$owner" == "0" ]]; then
      chown aaswitch:aaswitch "$dir"
    fi
  fi
}

ensure_dir "$HOME"
ensure_dir "$AASWITCH_HOME"
ensure_dir "$CLAUDE_CONFIG_DIR"
ensure_dir "$CODEX_HOME"
ensure_dir "$XDG_CONFIG_HOME"
ensure_dir "$XDG_DATA_HOME"
ensure_dir "$XDG_STATE_HOME"
ensure_dir "$XDG_CACHE_HOME"

if [[ "$#" -gt 0 ]]; then
  if [[ "$(id -u)" == "0" ]]; then
    exec gosu aaswitch "$@"
  fi
  exec "$@"
fi

if [[ -z "${AASWITCH_PASSWORD:-}" ]]; then
  {
    echo "[aaswitch] WARNING: AASWITCH_PASSWORD is not set."
    echo "[aaswitch] The daemon accepts unauthenticated control connections from any client that can reach it."
    echo "[aaswitch] Set AASWITCH_PASSWORD for any published port or network-reachable deployment."
  } >&2
fi

if [[ ! -f /etc/aaswitch-server-entry ]]; then
  echo "[aaswitch] FATAL: /etc/aaswitch-server-entry is missing." >&2
  exit 1
fi

entry="$(cat /etc/aaswitch-server-entry)"
echo "[aaswitch] starting daemon on ${AASWITCH_LISTEN} with web UI ${AASWITCH_WEB_UI_ENABLED}"
if [[ "$(id -u)" == "0" ]]; then
  exec gosu aaswitch node "$entry"
fi
exec node "$entry"
