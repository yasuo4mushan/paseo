# Example child image that adds agent CLIs to the official aaswitch image.
#
# Build:
#   docker build -f docker/Dockerfile.agents.example -t aaswitch-with-agents .
#
# Then set `image: aaswitch-with-agents` in docker/docker-compose.example.yml.

FROM ghcr.io/aaswitch/aaswitch:latest

USER root
RUN npm install -g \
  @anthropic-ai/claude-code \
  @openai/codex \
  opencode-ai

# Leave the image user as root. The base entrypoint prepares mounted volumes,
# then drops the daemon and launched agents to the non-root `aaswitch` user.
